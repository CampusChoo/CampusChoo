# Production env example for Railway + Neon

# Postgres (from Neon). Ensure sslmode=require on the query string.
DATABASE_URL=postgresql://<user>:<password>@<host>.neon.tech:5432/<dbname>?sslmode=require
DIRECT_URL=postgresql://<user>:<password>@<host>.neon.tech:5432/<dbname>?sslmode=require

# Redis (optional - e.g., Upstash). Leave blank if not used.
REDIS_URL=

# Auth
JWT_SECRET=<replace_with_strong_random_secret>

# Cloudinary (optional)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Paystack (server-side key)
PAYSTACK_SECRET_KEY=

# Public client URL (used for callbacks and CORS)
CLIENT_BASE_URL=https://your-client-domain.com
CORS_ORIGINS=https://your-client-domain.com

# Server port
PORT=4000
